# Copy this file to .env.
# The default values run the demo on your computer with the mock Entra ID.

# --- The API (app/) ---

# Your Entra ID tenant ID. The API accepts tokens from this tenant only.
TENANT_ID=11111111-1111-1111-1111-111111111111

# The client ID of registration A (the app registration of the API).
API_CLIENT_ID=22222222-2222-2222-2222-222222222222

# The address of the mock Entra ID.
# For a real tenant, delete this line. The default is https://login.microsoftonline.com.
# Do not deploy the API with this value.
AUTHORITY_BASE_URL=http://localhost:4050

# Optional. The client IDs that can call the API, with a comma between them.
# If the value is empty, the API accepts all clients of the tenant.
ALLOWED_CLIENT_IDS=

# --- The demo client (scripts/demo_client.py) and the mock Entra ID (dev/mock_entra.py) ---

# The client ID of registration B (the app registration of the client).
DEMO_CLIENT_ID=33333333-3333-3333-3333-333333333333

# The client secret of registration B. The mock Entra ID accepts this value only.
DEMO_CLIENT_SECRET=demo-secret

# The address of the API.
API_BASE_URL=http://localhost:8000

# Optional. The Application ID URI of registration A. The default is api://<API_CLIENT_ID>.
# API_APP_ID_URI=
